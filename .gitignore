tools/light-pollution/**/*.tif
tools/light-pollution/**/*.npy
tools/light-pollution/**/*.npz
tools/light-pollution/**/*.f32

# Light-pollution generated binaries and local fixtures (large)
tools/light-pollution/output/artifacts/
tools/light-pollution/**/*.bin
