# Swift Package Manager
.build/
# SPM clones into ./Packages. On case-insensitive volumes that pattern also
# matches ./packages (our engine tree), so re-include the lowercase path.
/Packages/
!/packages/
!/packages/**
# The re-include above would otherwise track SwiftPM build products.
packages/astro-engine-swift/.build/
packages/astro-engine-swift/.swiftpm/
packages/astro-engine-swift/Package.resolved
Package.resolved
.swiftpm/

# Generated AstroEngine calibration and catalog copied at build time.
# Canonical source is contracts/data/. The parent directory is tracked via
# .gitkeep so SwiftPM can evaluate `.copy("Resources/data")` on a clean
# checkout; package tests do not read this copy.
packages/astro-engine-swift/Sources/AstroEngine/Resources/data/calibration/
packages/astro-engine-swift/Sources/AstroEngine/Resources/data/catalog/


# IDE
.vscode/
.idea/
**/__pycache__/
packages/astro-engine-python/build/
packages/astro-host-python/build/

